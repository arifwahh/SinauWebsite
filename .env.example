# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env ke git.

DB_USER=sinau_admin
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=sinau_db

# Minimal 32 karakter. Contoh generate: openssl rand -hex 32
JWT_SECRET=

# Kunci master 32 byte (64 karakter hex) untuk mengenkripsi kunci video offline di DB.
# Generate: openssl rand -hex 32
OFFLINE_KEY_MASTER=

# Payment gateway Xendit (kosongkan jika belum dipakai; invoice akan mock & webhook akan menolak request)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Google Drive Service Account (JSON string atau path file) untuk streaming video privat
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/service-account.json

# Google OAuth 2.0 (untuk tombol Login dengan Google)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Email SMTP & URL Frontend (opsional saat dev; jika SMTP_HOST kosong, email dicetak ke log)
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sinau.id

# Opsional
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
