# Salin file ini menjadi .env lalu isi nilainya:  cp .env.example .env
# JANGAN commit file .env ke git.

DB_USER=sinau_admin
DB_PASSWORD=ganti_dengan_password_kuat
DB_NAME=sinau_db

# Minimal 32 karakter. Contoh generate: openssl rand -hex 32
JWT_SECRET=

# Kunci master 32 byte (64 karakter hex) untuk mengenkripsi kunci video offline di DB.
# Generate: openssl rand -hex 32
OFFLINE_KEY_MASTER=

# Payment gateway (kosongkan jika belum dipakai; webhook akan menolak request)
MIDTRANS_SERVER_KEY=
XENDIT_CALLBACK_TOKEN=

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Opsional
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
